{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SGDK: Build ROM",
            "type": "shell",
            "command": "${workspaceFolder}/build.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "SGDK: Clean",
            "type": "shell",
            "command": "${workspaceFolder}/build.sh clean",
            "group": "build"
        },
        {
            "label": "SGDK: Run in BlastEm",
            "type": "shell",
            "command": "${workspaceFolder}/run.sh",
            "group": "test",
            "dependsOn": "SGDK: Build ROM"
        }
    ]
}
